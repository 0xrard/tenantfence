# TenantFence orchestrator configuration — copy to `.env` and fill in.
# The deployed InvoiceFlow URL from Phase 1 (no trailing slash).
TARGET_URL=https://tenantfence.vercel.app

# Note: `npm run verify:local` ignores TARGET_URL and verifies a local
# target instead (default http://localhost:3000; override below).
# TF_LOCAL_URL=http://localhost:3000

# Optional: command used to invoke Kane CLI (default: kane-cli).
# KANE_CMD=kane-cli

# Optional: when set, the agent bridge pipes the patch prompt to this
# command automatically instead of waiting for a human to hand it over.
# AGENT_CMD=
